{
  "name": "pathwise",
  "private": true,
  "description": "pathwise backend: Amplify auth, Serverless API and Terraform infrastructure",
  "scripts": {
    "sandbox": "ampx sandbox --once --outputs-out-dir ../pathwise",
    "sandbox:watch": "ampx sandbox --outputs-out-dir ../pathwise",
    "typecheck": "tsc --noEmit && tsc -p amplify --noEmit",
    "test": "jest",
    "deploy:api": "serverless deploy",
    "tf:init": "terraform -chdir=terraform init",
    "tf:plan": "terraform -chdir=terraform plan",
    "tf:apply": "terraform -chdir=terraform apply"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-presigned-post": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@google/genai": "^2.31.0",
    "jose": "^6.2.13",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^3.25.17"
  }
}
